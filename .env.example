# PostgreSQL (docker compose postgres 서비스와 동일 값 권장)
PLAYOPS_ENV_FILE_PRESENT=true

POSTGRES_DB=playops
POSTGRES_USER=playops
POSTGRES_PASSWORD=playops
# 호스트에 노출할 postgres 포트. 컨테이너 내부는 항상 5432다.
POSTGRES_PORT=5433

# PlayOps Web bootstrap login (최초 관리자 계정)
LOGIN_USERNAME=admin
LOGIN_PASSWORD=admin

# API: dev(로컬 bootRun) | prod(docker compose / docker-compose.dev.yml api)
SPRING_PROFILES_ACTIVE=dev

# 로컬 gradle bootRun 시 dev 프로필 기본값과 맞춤 (필요 시만 override)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/playops
# SPRING_DATASOURCE_USERNAME=playops
# SPRING_DATASOURCE_PASSWORD=playops

API_PORT=8080
WEB_PORT=3000
API_DEBUG_PORT=5005

# 동시에 돌릴 Playwright 실행 수. 서버 RAM에 가장 크게 영향을 준다.
# docs/ops-sizing.md 기준 단일 서버는 2부터 시작해 사용량을 보고 늘린다.
WORKER_CONCURRENCY=2

# API가 테스트 실행 컨테이너를 직접 띄울지 여부. 로컬에서 컨테이너를
# 띄우고 싶지 않으면 false로 둔다.
PLAYOPS_DOCKER_ENABLED=true

# 프로젝트 시크릿(GitHub PAT, AI 공급자 키 등)을 DB에 AES-GCM으로 저장할 때
# 쓰는 키. 문자열을 SHA-256 해싱해 256비트 AES 키로 사용한다.
#   - prod 프로필: 비어 있으면 API가 기동에 실패한다. 반드시 채울 것.
#   - dev 프로필: 비어 있으면 고정 플레이스홀더 키로 동작한다(경고 로그).
# 한 번 정하면 바꾸지 말 것. 바꾸면 이미 저장된 암호문을 복호화할 수 없다.
# 생성: openssl rand -base64 32
PLAYOPS_ENCRYPTION_KEY=

# Amazon Bedrock 으로 Claude 를 호출하려면 아래를 채운다 (비우면 관리자 화면에 등록한 Claude API 키를 쓴다).
# BEDROCK_MODEL_ID 는 모델 ID 또는 추론 프로파일 ID. 예: global.anthropic.claude-haiku-4-5-20251001-v1:0
# 액세스 키는 Bedrock 호출 권한(bedrock:InvokeModel)만 가진 IAM 사용자의 것을 쓴다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
BEDROCK_MODEL_ID=

# 이번 달 AI 추정 비용이 이 값(USD)에 닿으면 호출을 거부한다. 0 이면 제한 없음.
# AI 설정 화면에 단가를 입력해야 동작한다.
AI_MONTHLY_BUDGET_USD=0

# Runtime cache는 docker-compose.yml 기준 ./storage/cache 아래에 저장됩니다.
# Docker Desktop 이미지/레이어 저장소는 별도 Docker Desktop 설정에서 D 드라이브로 이동해야 합니다.
